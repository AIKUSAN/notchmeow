{
  "version": 1,
  "note": "noteCheck(text) -> {ok, reason, text}; reason is ok, empty, long, secret or path. rememberOffers(userText) -> at most two {section, text}, from the user's own message only.",
  "check": [
    {"name":"a plain sentence","text":"I like short answers.","expect":{"ok":true,"reason":"ok","text":"I like short answers."}},
    {"name":"spaces and line breaks fold into one space","text":"  I like\n short   answers. ","expect":{"ok":true,"reason":"ok","text":"I like short answers."}},
    {"name":"an invisible character is removed","text":"Bidi\u202e text","expect":{"ok":true,"reason":"ok","text":"Bidi text"}},
    {"name":"empty","text":"","expect":{"ok":false,"reason":"empty","text":""}},
    {"name":"only spaces","text":"   \n ","expect":{"ok":false,"reason":"empty","text":""}},
    {"name":"not text","text":42,"expect":{"ok":false,"reason":"empty","text":""}},
    {"name":"200 code points is fine","text":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","expect":{"ok":true,"reason":"ok","text":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}},
    {"name":"201 code points is too long","text":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","expect":{"ok":false,"reason":"long","text":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}},
    {"name":"a lone surrogate goes","text":"hi \ud800 there","expect":{"ok":true,"reason":"ok","text":"hi there"}},
    {"name":"a reversed surrogate pair goes","text":"\udc00\ud800","expect":{"ok":false,"reason":"empty","text":""}},
    {"name":"an emoji is kept whole","text":"hi 😀","expect":{"ok":true,"reason":"ok","text":"hi 😀"}},
    {"name":"a soft hyphen goes","text":"a\u00adb","expect":{"ok":true,"reason":"ok","text":"ab"}},
    {"name":"a combining grapheme joiner goes","text":"a\u034fb","expect":{"ok":true,"reason":"ok","text":"ab"}},
    {"name":"a Hangul filler goes","text":"a\u3164b","expect":{"ok":true,"reason":"ok","text":"ab"}},
    {"name":"a variation selector goes","text":"a\ufe0fb","expect":{"ok":true,"reason":"ok","text":"ab"}},
    {"name":"an invisible operator goes","text":"a\u2061b","expect":{"ok":true,"reason":"ok","text":"ab"}},
    {"name":"a halfwidth filler goes","text":"a\uffa0b","expect":{"ok":true,"reason":"ok","text":"ab"}},
    {"name":"a tag character goes","text":"a\udb40\udc41b","expect":{"ok":true,"reason":"ok","text":"ab"}},
    {"name":"200 emoji are 200 code points: kept whole","text":"😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀","expect":{"ok":true,"reason":"ok","text":"😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀"}},
    {"name":"201 emoji are too long","text":"😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀","expect":{"ok":false,"reason":"long","text":"😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀"}},
    {"name":"a long text with a secret: the secret reason, no text","text":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa ghp_abcdefghijklmnopqrstuvwxyz0123","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a long text with a path: the path reason, no text","text":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa /Users/sam/x","expect":{"ok":false,"reason":"path","text":""}},
    {"name":"the word password","text":"My password is hunter2","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"an Anthropic key shape","text":"key sk-ant-api03-abcdefghijklmnop","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a GitHub token","text":"token ghp_abcdefghijklmnopqrstuvwxyz0123","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"an AWS key id","text":"AWS AKIAABCDEFGHIJKLMNOP","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a card number","text":"Card 4111 1111 1111 1111","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a card number with dashes","text":"Card 4111-1111-1111-1111","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a card number after other digits: every window is checked","text":"pin 1234 4111 1111 1111 1111","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"ISO dates are a break, never part of a card number","text":"Sprint 2026-10-17 2026-11-05","expect":{"ok":true,"reason":"ok","text":"Sprint 2026-10-17 2026-11-05"}},
    {"name":"two ISO dates whose digits pass Luhn across the joint are ok","text":"Sprint 2026-10-01 2026-10-01","expect":{"ok":true,"reason":"ok","text":"Sprint 2026-10-01 2026-10-01"}},
    {"name":"a card number after an ISO date is still secret","text":"on 2026-10-17 pin 1234 4111 1111 1111 1111","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"digits that fail the card check in every window are kept","text":"Call 1234 5678 9012 3457","expect":{"ok":true,"reason":"ok","text":"Call 1234 5678 9012 3457"}},
    {"name":"a long random string","text":"The build id is 9f86d081884c7d659a2feaa0c55ad015","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a JWT (eyJ and a dotted word)","text":"token eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0In0.abc","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a Stripe live key (sk_ with an underscore)","text":"key sk_live_abcdefghijklmnop","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a Hugging Face token","text":"token hf_abcdefghijklmnopqrstuvwx","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a Google OAuth token (ya29.)","text":"token ya29.a0AfH6SMBabcdefghijklmnop","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a bearer token","text":"Authorization: Bearer abcdefghijklmnopqrstuvwxyz0123","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a short bearer word is not a token","text":"Bearer ok","expect":{"ok":true,"reason":"ok","text":"Bearer ok"}},
    {"name":"any PEM header","text":"-----BEGIN PRIVATE KEY-----","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a web address is not a random word","text":"I work on https://github.com/acme/notchmeow2","expect":{"ok":true,"reason":"ok","text":"I work on https://github.com/acme/notchmeow2"}},
    {"name":"a www address with an ordinary path is not a random word","text":"see www.acme.dev/notchmeow-companion-contract-v2-final","expect":{"ok":true,"reason":"ok","text":"see www.acme.dev/notchmeow-companion-contract-v2-final"}},
    {"name":"a web address with userinfo (user:pass@) is secret","text":"https://u:p4ssw0rd@x.com/a","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a random token in a web address query is secret","text":"https://x.com/cb?token=q8Zr2LmX9vB4nK7tW1yP3sD6fG0hJ5aE","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a date-time with a token glued on is secret","text":"2026-10-17Tq8Zr2LmX9vB4nK7tW1yP3sD6fG0hJ5aE","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a dashed key with uppercase parts is secret","text":"aB3x-Kq9Z-mP2w-Lr8T-xY5v-Nq1s","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a dashed key with mixed letter-digit parts is secret","text":"q8zr-2lmx-9vb4-nk7t-w1yp-3sd6","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"an ISO date-time is not a random word","text":"deadline is 2026-10-17T12:30:45.123Z","expect":{"ok":true,"reason":"ok","text":"deadline is 2026-10-17T12:30:45.123Z"}},
    {"name":"a kebab name of 3 or more short parts, one with a digit, is not a random word","text":"my project is notchmeow-companion-contract-v2-final","expect":{"ok":true,"reason":"ok","text":"my project is notchmeow-companion-contract-v2-final"}},
    {"name":"a 32-character random token is secret","text":"q8Zr2LmX9vB4nK7tW1yP3sD6fG0hJ5aE","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"an sk- token with dashes stays secret","text":"key sk-proj-abcdefghijklmnop","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"an eyJ token with dashes stays secret","text":"token eyJhbGciOiJIUzI1NiJ9-x-y","expect":{"ok":false,"reason":"secret","text":""}},
    {"name":"a long plain word is not random","text":"I love internationalization","expect":{"ok":true,"reason":"ok","text":"I love internationalization"}},
    {"name":"a full path","text":"The repo is in /Users/sam/Code/notchmeow","expect":{"ok":false,"reason":"path","text":""}},
    {"name":"a home path","text":"My key lives in ~/.ssh/id_ed25519","expect":{"ok":false,"reason":"path","text":""}},
    {"name":"a Windows path","text":"Use C:\\Users\\sam","expect":{"ok":false,"reason":"path","text":""}},
    {"name":"a web address is not a path","text":"See https://example.com/docs/a for details","expect":{"ok":true,"reason":"ok","text":"See https://example.com/docs/a for details"}},
    {"name":"and/or is not a path","text":"I use and/or a lot","expect":{"ok":true,"reason":"ok","text":"I use and/or a lot"}}
  ],
  "offers": [
    {"name":"what you are working on","text":"I'm working on NotchMeow. Can you help?","expect":[{"section":"Projects","text":"I'm working on NotchMeow."}]},
    {"name":"a curly apostrophe counts","text":"I’m working on GraceGrip","expect":[{"section":"Projects","text":"I’m working on GraceGrip"}]},
    {"name":"remember that …","text":"remember that my cat is called Momo","expect":[{"section":"About you","text":"My cat is called Momo"}]},
    {"name":"a full stop with no space after it does not end a sentence","text":"I like tea.and coffee","expect":[{"section":"Preferences","text":"I like tea.and coffee"}]},
    {"name":"a line break ends a sentence","text":"I like tea\nI prefer coffee","expect":[{"section":"Preferences","text":"I like tea"},{"section":"Preferences","text":"I prefer coffee"}]},
    {"name":"the first letter is upper-cased with full Unicode case","text":"remember that ßa is fine","expect":[{"section":"About you","text":"SSa is fine"}]},
    {"name":"a kebab project name is kept whole","text":"my project is notchmeow-companion-contract-v2-final","expect":[{"section":"Projects","text":"my project is notchmeow-companion-contract-v2-final"}]},
    {"name":"two offers at most, in order; a secret is never offered","text":"Call me Ike! I prefer short answers. My password is x.","expect":[{"section":"About you","text":"Call me Ike!"},{"section":"Preferences","text":"I prefer short answers."}]},
    {"name":"a secret is never offered","text":"Remember that my GitHub token is ghp_abcdefghijklmnopqrstuvwxyz0123","expect":[]},
    {"name":"a path is never offered","text":"I work on /Users/sam/Code/notchmeow","expect":[]},
    {"name":"always and never are preferences","text":"Always answer in French.","expect":[{"section":"Preferences","text":"Always answer in French."}]},
    {"name":"a question is not an offer","text":"What's the weather?","expect":[]},
    {"name":"the same sentence twice is offered once","text":"I like tea. I like tea.","expect":[{"section":"Preferences","text":"I like tea."}]},
    {"name":"not text","text":null,"expect":[]}
  ]
}
